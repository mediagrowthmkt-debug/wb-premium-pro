Options -MultiViews
RewriteEngine On

# --- Canonicalization: kill .html duplicates (301 to clean URL) ---
# Any browser request ending in .html is redirected to the clean URL,
# so /service-areas/marblehead.html -> /service-areas/marblehead (no cannibalization).
RewriteCond %{THE_REQUEST} \s/(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- Onda 3: consolidate thin duplicate pages (301 to the strong page) ---
RewriteRule ^services/general-contractor-peabody/?$ /service-areas/peabody [R=301,L]
RewriteRule ^services/general-contractor-wakefield/?$ /service-areas/wakefield [R=301,L]
RewriteRule ^services/general-contractor-saugus/?$ /service-areas/saugus [R=301,L]
RewriteRule ^services/general-contractor-middleton/?$ /service-areas/middleton [R=301,L]
RewriteRule ^services/home-remodeling-lynnfield/?$ /service-areas/lynnfield [R=301,L]
RewriteRule ^services/home-remodeling-peabody/?$ /service-areas/peabody [R=301,L]
RewriteRule ^services/home-remodeling-middleton/?$ /service-areas/middleton [R=301,L]
RewriteRule ^services/painting-company-peabody/?$ /services/interior-painting [R=301,L]

# Serve clean SEO URLs such as /services/kitchen-remodeling
# from the existing static HTML files.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
